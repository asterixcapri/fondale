{
  "name": "@fondale/dialogue-server",
  "version": "0.4.0",
  "description": "The Node.js Dialogue Provider server for Fondale games.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "fondale-dialogue-server": "./dist/main.js"
  },
  "files": [
    "dist",
    ".env.local.example",
    "compose.yml",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local --import tsx src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "build": "vite build --config vite.config.ts && tsc -p tsconfig.build.json",
    "verify": "npm run verify:unit",
    "verify:unit": "node --import tsx --test src/configuration.spec.ts src/development-entry.spec.ts src/http-transport.spec.ts src/live-dialogue-model.spec.ts src/server-startup.spec.ts",
    "verify:integration": "node --import tsx --test src/dialogue-provider.integration.spec.ts src/server.integration.spec.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "@mastra/core": "^1.58.0",
    "@mastra/memory": "^1.26.1",
    "@mastra/pg": "^1.20.0",
    "hono": "^4.13.1",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "fondale": "0.4.0"
  },
  "devDependencies": {
    "fondale": "file:../..",
    "@types/node": "^22.20.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vite": "^6.4.3"
  }
}
