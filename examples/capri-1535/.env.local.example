DATABASE_URL=postgresql://fondale:fondale@127.0.0.1:54329/fondale_dialogue
DIALOGUE_ADAPTER_HOST=127.0.0.1
DIALOGUE_ADAPTER_PORT=4315

# The adapter answers with its deterministic model unless this asks for the
# live one. `openrouter` additionally requires OPENROUTER_API_KEY.
DIALOGUE_ADAPTER_MODEL=deterministic

# Server-side only: never prefixed with VITE_ and never sent to the browser.
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL_ID=deepseek/deepseek-v4-flash-0731
