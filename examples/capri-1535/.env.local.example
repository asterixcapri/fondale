# The only setting this game reads. Optional: leaving it unset uses the local
# default, http://127.0.0.1:4315/dialogue.
#
# Server-side only settings — DATABASE_URL, DIALOGUE_MODEL_API_KEY and the rest —
# belong to packages/dialogue-server and never reach the browser. Never prefix a
# credential with VITE_: everything so prefixed is bundled into the page.
VITE_DIALOGUE_SERVER_URL=http://127.0.0.1:4315/dialogue
