DATABASE_URL=postgresql://fondale:fondale@127.0.0.1:54329/fondale_dialogue
DIALOGUE_ADAPTER_HOST=127.0.0.1
DIALOGUE_ADAPTER_PORT=4315

# Where the Character's words come from, never which vendor hosts them.
# `authored` speaks the Example's own prologue answers, needs no key and no
# network. `live` reaches a language model and additionally requires
# DIALOGUE_MODEL_API_KEY.
DIALOGUE_ADAPTER_MODEL=authored

# Server-side only: never prefixed with VITE_ and never sent to the browser.
# The vendor lives here, in the values, so changing it changes no code.
# DIALOGUE_MODEL_API_KEY=sk-or-v1-...
# DIALOGUE_MODEL_ID=deepseek/deepseek-v4-flash-0731
# DIALOGUE_MODEL_PROVIDER_ID=openrouter
# DIALOGUE_MODEL_BASE_URL=https://openrouter.ai/api/v1
