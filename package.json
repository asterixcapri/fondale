{
  "name": "fondale",
  "version": "0.4.1",
  "description": "A web-native, TypeScript-first point-and-click adventure engine.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asterixcapri/fondale.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "docs/public",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "dev": "npm run build:package && vite --force",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace @fondale/dialogue-server",
    "build:package": "vite build --config vite.lib.config.ts && tsc -p tsconfig.declarations.json",
    "build:dialogue-server": "npm run build --workspace @fondale/dialogue-server",
    "build": "npm run build:package && npm run build:dialogue-server && npm run typecheck && npm run verify:dialogue-server && npm run verify:architecture && npm run verify:architecture-doc && npm run verify:release-preparation && npm run verify:docs && npm run verify:runtime-asset-normaliser",
    "verify:dialogue-server": "npm run verify --workspace @fondale/dialogue-server",
    "verify:dialogue-server:integration": "npm run verify:integration --workspace @fondale/dialogue-server",
    "verify:architecture": "node --test tools/verify-architecture.spec.mjs && node tools/verify-architecture.mjs",
    "verify:architecture-doc": "node --test tools/verify-architecture-doc.spec.mjs && node tools/verify-architecture-doc.mjs",
    "verify:release-preparation": "node --test tools/verify-release-preparation.spec.mjs && node tools/verify-release-preparation.mjs",
    "verify:docs": "node --test tools/verify-docs.spec.mjs && node tools/verify-docs.mjs",
    "verify:runtime-asset-normaliser": "node --test skills/fabrication-cycle/scripts/normalise-runtime-asset.spec.mjs",
    "verify": "playwright test"
  },
  "dependencies": {
    "pixi.js": "^8.19.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.3"
  }
}
