{
  "name": "@asterixcapri/fondale",
  "version": "1.1.0",
  "description": "A web-native, TypeScript-first point-and-click adventure engine.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs/public",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "dev": "npm run build:package && vite --force",
    "prototype:capri-hud": "npm --prefix examples/capri-1535 run prototype:hud",
    "typecheck": "tsc --noEmit",
    "build:package": "vite build --config vite.lib.config.ts && tsc -p tsconfig.declarations.json",
    "build": "npm run build:package && npm run typecheck && npm run verify:docs",
    "verify:docs": "node tools/verify-docs.mjs",
    "verify": "playwright test"
  },
  "dependencies": {
    "pixi.js": "^8.19.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.3"
  }
}
